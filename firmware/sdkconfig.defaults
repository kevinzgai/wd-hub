# WorkBuddy 看板固件 · ESP32-S3 默认配置
# 参考 78/xiaozhi-esp32 sdkconfig.defaults.esp32s3，按需精简

# ---- 目标芯片 ----
CONFIG_IDF_TARGET="esp32s3"

# ---- Flash：16MB，QIO ----
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- 分区表 ----
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ---- PSRAM：8MB Octal @ 80MHz（flash_id 已验证 Embedded PSRAM 8MB）----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# ---- CPU 240MHz ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ---- 编译优化：体积优先，固件小启动快 ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# ---- 主任务栈 ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- FreeRTOS tick 1000Hz，LVGL 动画更顺 ----
CONFIG_FREERTOS_HZ=1000

# ---- 日志 ----
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# ---- WiFi ----
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=y

# ---- Bluetooth LE / NimBLE ----
# WorkBuddy 控制台要靠 BLE 收主机推的帧（Service 4fafc201… / Char beb5483e…）。
# 只开单连接 peripheral 所需的最小配置：本设备永远是被连的一方，
# 不扫描、不主动连别人，因此关掉 CENTRAL 与 OBSERVER 省 RAM。
#
# ⚠ 与 WiFi 共存：S3 支持 BLE + WiFi 同时工作（CONFIG_ESP_COEX_ENABLED 已开），
#   但两者抢 2.4G 射频，共存时 BLE 吞吐会掉。控制台的帧都很小（≤480B/2s），
#   这点带宽足够，不需要为它调整 WiFi 参数。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
# 不把配对信息落 NVS：控制台没有配对流程，主机按设备名直连。
CONFIG_BT_NIMBLE_NVS_PERSIST=n
CONFIG_FREERTOS_USE_TRACE_FACILITY=n

# NimBLE 日志降到 WARNING。INFO 级别下每发一个 notify 就 print 一行
# "GATT procedure initiated"，录音时每秒 50 包 × 2 片 = 100 行，
# 串口 115200 根本吐不完（100 行 × ~50B = 5KB/s，接近串口上限的一半），
# 直接和音频采集抢 CPU，实测造成丢帧与实时率偏低。
# 这一项必须留在 defaults 里：改 sdkconfig 会在下次 reconfigure 时被覆盖。
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_BT_NIMBLE_LOG_LEVEL=2

# ---- LVGL ----
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_NONE=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y

# 精简组件，只保留要用的
CONFIG_LV_USE_ANIMIMG=n
CONFIG_LV_USE_CALENDAR=n
CONFIG_LV_USE_CHART=n
CONFIG_LV_USE_COLORWHEEL=n
CONFIG_LV_USE_KEYBOARD=n
CONFIG_LV_USE_LIST=n
CONFIG_LV_USE_MENU=n
CONFIG_LV_USE_METER=n
CONFIG_LV_USE_SPAN=n
CONFIG_LV_USE_SPINBOX=n
CONFIG_LV_USE_SPINNER=n
CONFIG_LV_USE_TABLE=n
CONFIG_LV_USE_TABVIEW=n
CONFIG_LV_USE_TILEVIEW=n
CONFIG_LV_USE_WIN=n

# 字体：只留用到的几个，其余关掉能省几百 KB
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
