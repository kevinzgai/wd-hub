# ==========================================
# 临时诊断项目 / 素材生成物
# ==========================================
# adc-probe：排查电池引脚时另立的最小验证工程，
# 只为确认 ADC2_CH6=GPIO17 与 GPIO38 充电检测，
# 结论已固化进 board_config.h 注释，工程本身不必留。
adc-probe/

# 宠物像素画的预览图，由 tools/gen_pet.py 的思路临时渲染，
# 素材真身是 pet_frames.c，这张 png 只是给人看的，随时可重生成。
tools/pet_preview.png

# 宠物造型的调参过程图（8 版迭代的中间产物，共 600KB）。
# 结论已固化进 gen_pet.py 的注释，过程图没有留存价值。
tools/petproto/

# 屏显模拟与方案对比图，由 tools/pet_mock_screen.py、pet_opa_compare.py 生成。
# 只用于验证时肉眼看，不进版本库。
tools/pet_screen_*.png
tools/pet_opa_options.png
tools/pet_compare.png
tools/pet_done_frames.png

